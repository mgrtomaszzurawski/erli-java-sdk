<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle config for the hand-written erli-java-sdk modules. Encodes the fleet's documented code
  standards (see the binding CLAUDE.md and claude/6): English identifiers, no magic numbers/strings,
  no 1-3 char names, blocks and imports kept clean. Formatting/whitespace is owned by Spotless, so
  this config deliberately does NOT re-check indentation or whitespace. The generated erli-rest-models
  module is not checked. Suppressions live in config/checkstyle/suppressions.xml.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Applies to code, not comment prose or imports: skip lines that are a block-comment
             opener/body (/* , /** , * ) or a line comment (//), and import statements. -->
        <property name="ignorePattern" value="^\s*(/\*|\*|//).*$|^import .*$"/>
    </module>

    <module name="TreeWalker">
        <!-- One top-level type per file, named after the file. -->
        <module name="OuterTypeFilename"/>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>

        <!-- Naming: standard camelCase / UPPER_SNAKE. -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="PackageName"/>

        <!-- Forbid cryptic 1-2 char names (tmp/ret/val-class defects and single letters). Established
             3-char domain idioms (raw generated model, url/uri, sku/ean, pln) are allowed — they are
             readable, and /review still rejects a cryptic 3-char name an LLM can spot but a regex
             cannot. Short idioms i/j (loops), e/ex (catch), id, and of/to (factories) are permitted. -->
        <module name="MemberName">
            <property name="format" value="^(id|[a-z][a-zA-Z0-9]{2,})$"/>
            <message key="name.invalidPattern"
                     value="Member ''{0}'' must be descriptive (no cryptic 1-2 char names)."/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^(i|j|e|ex|id|of|to|[a-z][a-zA-Z0-9]{2,})$"/>
            <message key="name.invalidPattern"
                     value="Local ''{0}'' must be descriptive (no cryptic 1-2 char names; i/j/e/ex allowed)."/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^(id|of|to|[a-z][a-zA-Z0-9]{2,})$"/>
            <message key="name.invalidPattern"
                     value="Parameter ''{0}'' must be descriptive (no cryptic 1-2 char names)."/>
        </module>

        <!-- Magic numbers: every literal except 0,1,2,-1 must live behind a named constant. The code
             already does this well, so the point of the check is to keep it that way — it must NOT fire
             on the constant definitions themselves, including a literal passed to a factory inside a
             `static final` initializer (e.g. Duration.ofMillis(200)). ignoreFieldDeclaration waives the
             direct form; the wide constantWaiverParentToken list waives the wrapped form. -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
            <property name="ignoreAnnotationElementDefaults" value="true"/>
            <!-- constantWaiverParentToken left at its default (includes ASSIGN + METHOD_CALL), so a
                 literal that defines a constant — directly (= 401) or via a factory
                 (Duration.ofMillis(200)) — is waived. The check then fires only on numbers in logic. -->
        </module>

        <!-- Blocks and control flow. -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO, STATIC_INIT, INSTANCE_INIT"/>
        </module>
        <module name="EmptyCatchBlock"/>
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="OneStatementPerLine"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>

        <!-- Design. -->
        <module name="OneTopLevelClass"/>
        <module name="HideUtilityClassConstructor"/>
    </module>
</module>
